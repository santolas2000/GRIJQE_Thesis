\tikzset{
  error bar legend helper/.style={
    sharp plot,
    mark repeat=2,
    mark phase=1,
    mark=none,
    solid,
    xshift=0.30cm,
  },
}

\pgfplotsset{
  error bar legend/.style={
    legend image code/.code={
      \draw[error bar legend helper, ##1] plot coordinates {(0cm, -0.15cm) (0cm, +0.15cm)};%
      \draw[error bar legend helper, ##1] plot coordinates {(-0.15cm, 0cm) (+0.15cm, 0cm)};%
    }
  },
}

%-------------------------------------------------------------------------------
% Colorbars
%-------------------------------------------------------------------------------
\pgfplotsset{
  colorbar top/.style n args={4}{
    colorbar horizontal,
    colorbar/width={2ex},
    colorbar style={
      % ----- Arguments -----
      xlabel=#1,
      xmin=#2, xmax=#3,
      xtick=#4, samples at=#4,
      % ----- Geometry -----
      at=(parent axis.north west), anchor=south west,
      yshift=3ex,
      % ----- Axis -----
      tick style={draw=none},
      ticklabel style={align=center},
      % x axis
      xlabel style={
        at={(0.,1.)}, anchor=south east,
        xshift=-2em, yshift=-.25ex
      },
      xticklabel pos=upper,
      xmajorticks=true, xminorticks=false,
    },
  },
  colorbar right/.style n args={4}{
    colorbar,
    colorbar/width={2ex},
    colorbar style={
      % ----- Arguments -----
      ylabel=#1,
      ymin=#2, ymax=#3,
      ytick=#4, samples at=#4,
      % ----- Geometry -----
      at=(parent axis.north east), anchor=north west,
      % ----- Axis -----
      tick style={draw=none},
      ticklabel style={align=center},
      % y axis
      ylabel style={
        at={(axis description cs:1,0)}, anchor=north west,
        xshift=-3ex,
        rotate=-90,
      },
      ymajorticks=true, yminorticks=false,
    },
  },
}

\pgfplotsset{
  colorbar top sampled line/.style n args={4}{
    colorbar top={#1}{#2}{#3}{#4},
    colorbar sampled line,
    colorbar style={
      % ----- Axis -----
      % x axis
      axis x line*=top,
      xmajorticks=true, xminorticks=false,
      % y axis
      axis y line=none,
      % ----- Marks -----
      mark=|, mark size={\pgfkeysvalueof{/pgfplots/colorbar/width}/2},
      mark options={thick, solid},
    },
  },
  colorbar right sampled line/.style n args={4}{
    colorbar right={#1}{#2}{#3}{#4},
    colorbar sampled line,
    colorbar style={
      % ----- Axis -----
      % x axis
      axis x line=none,
      % y axis
      axis y line*=right,
      ymajorticks=true, yminorticks=false,
      % ----- Marks -----
      mark=-, mark size={\pgfkeysvalueof{/pgfplots/colorbar/width}/2},
      mark options={thick, solid},
    },
  },
}

\pgfplotsset{
  colorbar solid/.style={
    colorbar style={
      mark options={thick, solid},
    },
  },
  colorbar dashed/.style={
    colorbar style={
      mark options={thick, dashed},
    },
  },
  colorbar dotted/.style={
    colorbar style={
      mark options={thick, densely dotted},
    },
  },
}

\pgfplotsset{
  colorbar reverse/.style={
    colorbar style={x dir=reverse, y dir=reverse, z dir=reverse},
  },
}

\pgfplotsset{
  colorbar solid/.style={
    colorbar style={
      mark options={thick, solid},
    },
  },
  colorbar dashed/.style={
    colorbar style={
      mark options={thick, dashed},
    },
  },
  colorbar dotted/.style={
    colorbar style={
      mark options={thick, densely dotted},
    },
  },
}

\pgfplotsset{
  colorbar no tick labels/.style={
    colorbar style={no tick labels},
  },
}

%-------------------------------------------------------------------------------
% Fixes and Workarounds
%-------------------------------------------------------------------------------
% https://tex.stackexchange.com/questions/665296/pgfplots-const-plot-mark-mid-with-ref
\pgfplotsset{
  const plot mark mid fix/.style = {
    const plot mark mid,
    legend image code/.code = {
      \draw[mark repeat=2, mark phase=2, const plot] plot coordinates {(0cm,0cm) (0.3cm,0cm) (0.6cm,0cm)};
    },
  },
}
