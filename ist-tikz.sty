%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% IST-TikZ                                                                     %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ist-tikz}[2024/08/01 v0.1 Setup PGF-TikZ environment]

%-------------------------------------------------------------------------------
% Class options
%-------------------------------------------------------------------------------
\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=isttikz, prefix=isttikz@}

\DeclareBoolOption[false]{pagenodes}

\DeclareBoolOption[false]{plots}
\DeclareBoolOption[false]{pies}
\DeclareBoolOption[false]{feynman}

\DeclareBoolOption[false]{compact}

\ProcessKeyvalOptions*

%-------------------------------------------------------------------------------
% Packages
%-------------------------------------------------------------------------------
% TikZ
\RequirePackage{tikz}

\usetikzlibrary{angles}
\usetikzlibrary{arrows.meta}
\usetikzlibrary{babel}
\usetikzlibrary{backgrounds}
\usetikzlibrary{calc}
\usetikzlibrary{decorations.pathreplacing,calligraphy}
\usetikzlibrary{decorations.text}
\usetikzlibrary{external}
\usetikzlibrary{patterns}
\usetikzlibrary{positioning}
\usetikzlibrary{quotes}
\usetikzlibrary{shapes}
\usetikzlibrary{scopes}

% tikzpagenodes
\ifisttikz@pagenodes
\RequirePackage{tikzpagenodes}
\fi

% PGFPlots
\ifisttikz@plots
\RequirePackage{pgfplots}
\RequirePackage{pgfplotstable}

\pgfplotsset{compat=1.18}

\usepgfplotslibrary{colormaps}
\usepgfplotslibrary{fillbetween}
\usepgfplotslibrary{groupplots}
\usepgfplotslibrary{polar}
\fi

% pgf-pie
\ifisttikz@pies
\RequirePackage{pgf-pie}
\fi

% TikZ-Feynman
\ifisttikz@feynman
\RequirePackage[compat=1.1.0]{tikz-feynman}
\RequirePackage[compat=1.1.0]{tikz-feynhand}
\tikzfeynmanset{warn luatex=false}

\tikzset{
  perturbative/.style={
    /tikz/decoration={
      markings,
      mark=at position #1 with {
        \draw[
          fill,
          outer sep=0pt, inner sep=0pt,
          minimum size=\feynhandblobsize,
          line width=\feynhandlinesize,
        ] circle [radius=1mm];
      },
    },
    /tikz/postaction={
      /tikz/decorate=true,
    },
  },
}
\fi

%-------------------------------------------------------------------------------
% Externalize
%-------------------------------------------------------------------------------
\newcommand*{\isttikz@datadir}{.}
\NewDocumentCommand{\datadir}{m}{\renewcommand*{\isttikz@datadir}{#1}}
\newcommand*{\isttikz@tikzdir}{.}
\NewDocumentCommand{\tikzdir}{m}{\renewcommand*{\isttikz@tikzdir}{#1}}
\newcommand*{\isttikz@figuresdir}{.}
\NewDocumentCommand{\figuresdir}{m}{\renewcommand*{\isttikz@figuresdir}{#1}}

\tikzexternalize[optimize=true, only named=true]
\tikzset{external/optimize command away={\includepdf}}

\AtBeginDocument{
  \tikzsetexternalprefix{\isttikz@figuresdir/}

  \ifisttikz@plots
  \pgfplotsset{table/search path=\isttikz@datadir}
  \fi

  \NewDocumentCommand{\includetikz}{sm}{
    \IfBooleanF{#1}{\tikzsetnextfilename{#2}}%
    \input{\isttikz@tikzdir/#2}%
  }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TikZ                                                                         %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\tikzset{
  node/.style={
    decoration={
      markings,
      transform={xshift=1.5ex},
      mark=at position 1 with \node{#1};
    },
    postaction=decorate,
  },
}

\tikzset{
  ->-/.style={
    decoration={
      markings,
      mark=at position #1 with \arrow>
    },
    postaction=decorate
  },
  ->-/.default=.5,
}

