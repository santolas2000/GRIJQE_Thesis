%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% PGFPlots                                                                     %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%-------------------------------------------------------------------------------
% General Settings
%-------------------------------------------------------------------------------
\pgfplotsset{
  scale only axis   = true,
  enlarge x limits  = false,
  legend cell align = left,
}

\pgfplotsset{
  every axis/.append style = {
    legend style      = {font = \footnotesize},
    tick label style  = {font = \footnotesize},
    label style       = {font = \small},
    title style       = {font = \small},
  },
}

%-------------------------------------------------------------------------------
% Colormaps
%-------------------------------------------------------------------------------
\pgfplotsset{
  cycle list/.define={viridis}{[indices of colormap={0,4,8,12,17} of viridis]},
  colormap={reverse viridis}{indices of colormap={\pgfplotscolormaplastindexof{viridis},...,0 of viridis}},
  cycle list/.define={reverse viridis}{[indices of colormap={0,4,8,12,17} of reverse viridis]},
  colormap={bluered}{color=(blue) color=(red)},
  cycle list/.define={bluered}{[of colormap=bluered]},
  colormap={rainbow}{color(0)=(violet); color(1)=(blue); color(2)=(cyan); color(3)=(green!75!black); color(4)=(yellow); color(5)=(orange); color(6)=(red)},
  cycle list/.define={rainbow}{[of colormap=rainbow]},
}

%-------------------------------------------------------------------------------
% Axis
%-------------------------------------------------------------------------------
\pgfplotsset{
  no axis/.style = {
    axis x line=none,
    axis y line=none,
    axis z line=none,
  },
  no colorbar axis/.style = {
    colorbar style={
      no axis,
    },
  },
}

\pgfplotsset{
  no axis labels/.style={
    xlabel={}, ylabel={}, zlabel={},
  },
}

% Ticks
\pgfplotsset{
  no ticks/.style={
    xtick=\empty, ytick=\empty, ztick=\empty,
  },
  no tick labels/.style={
    xticklabel=\empty, yticklabel=\empty, zticklabel=\empty,
  },
  no extra ticks/.style={
    extra x ticks=\empty, extra y ticks=\empty, extra z ticks=\empty,
  },
  no extra tick labels/.style={
    extra x tick labels=\empty, extra y tick labels=\empty, extra z tick labels=\empty,
  },
}

\pgfplotsset{
  base10 xticklabel/.style = {
    xticklabel=$10^{\pgfmathparse{\tick}\pgfmathprintnumber\pgfmathresult}$,
  },
  base10 yticklabel/.style = {
    yticklabel=$10^{\pgfmathparse{\tick}\pgfmathprintnumber\pgfmathresult}$,
  },
  base10 zticklabel/.style = {
    zticklabel=$10^{\pgfmathparse{\tick}\pgfmathprintnumber\pgfmathresult}$,
  },
  colorbar base10 ticklabel/.style = {
    colorbar style = {base10 xticklabel, base10 yticklabel, base10 zticklabel},
  },
}

\pgfplotsset{
  nonlog xticklabel/.style = {
    xticklabel = {
      \pgfkeys{/pgf/fpu=true}
      \pgfmathparse{exp(\tick)}%
      \pgfmathprintnumber[fixed relative, precision=3]{\pgfmathresult}
      \pgfkeys{/pgf/fpu=false}
    },
  },
  nonlog yticklabel/.style = {
    yticklabel = {
      \pgfkeys{/pgf/fpu=true}
      \pgfmathparse{exp(\tick)}%
      \pgfmathprintnumber[fixed relative, precision=3]{\pgfmathresult}
      \pgfkeys{/pgf/fpu=false}
    },
  },
  nonlog zticklabel/.style = {
    zticklabel = {
      \pgfkeys{/pgf/fpu=true}
      \pgfmathparse{exp(\tick)}%
      \pgfmathprintnumber[fixed relative, precision=3]{\pgfmathresult}
      \pgfkeys{/pgf/fpu=false}
    },
  },
  colorbar nonlog ticklabel/.style = {
    colorbar style = {nonlog xticklabel, nonlog yticklabel, nonlog zticklabel},
  },
}

\pgfplotsset{
  nonlog10 xticklabel/.style = {
    xticklabel = {
      \pgfkeys{/pgf/fpu=true}
      \pgfmathparse{10^(\tick)}%
      \pgfmathprintnumber[fixed relative, precision=3]{\pgfmathresult}
      \pgfkeys{/pgf/fpu=false}
    },
  },
  nonlog10 yticklabel/.style = {
    yticklabel = {
      \pgfkeys{/pgf/fpu=true}
      \pgfmathparse{10^(\tick)}%
      \pgfmathprintnumber[fixed relative, precision=3]{\pgfmathresult}
      \pgfkeys{/pgf/fpu=false}
    },
  },
  nonlog10 zticklabel/.style = {
    zticklabel = {
      \pgfkeys{/pgf/fpu=true}
      \pgfmathparse{10^\tick}%
      \pgfmathprintnumber[fixed relative, precision=3]{\pgfmathresult}
      \pgfkeys{/pgf/fpu=false}
    },
  },
  colorbar nonlog10 ticklabel/.style = {
    colorbar style = {nonlog10 xticklabel, nonlog10 yticklabel, nonlog10 zticklabel},
  },
}

%-------------------------------------------------------------------------------
% Legends
%-------------------------------------------------------------------------------
\pgfplotsset{
  legend image with text/.style={
    legend image code/.code={
      \node[anchor=center] at (0.3cm,0cm) {#1};
    },
  },
}
\newcommand*{\addemptylegend}[2][]{
  \addlegendimage{legend image with text=#1}
  \addlegendentry{#2}
}

\pgfplotsset{
  legend pos/north/.style={legend style={at={(0.50,0.97)},anchor=north}},
  legend pos/south/.style={legend style={at={(0.50,0.03)},anchor=south}},
  legend pos/east/.style ={legend style={at={(0.97,0.50)},anchor=east}},
  legend pos/west/.style ={legend style={at={(0.03,0.50)},anchor=west}},
  legend pos/outer north/.style={legend style={at={(0.50,+1.03)},anchor=south}},
  legend pos/outer south/.style={legend style={at={(0.50,-0.03)},anchor=north}},
  % https://tex.stackexchange.com/questions/278530/how-i-can-customize-a-legend-on-pgfplots
}

