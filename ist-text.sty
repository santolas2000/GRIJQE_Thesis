%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% IST-Text                                                                     %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ist-text}[2024/03/08 v0.1 Fonts and text]

\RequirePackage{ist-texver}

%-------------------------------------------------------------------------------
% Class options
%-------------------------------------------------------------------------------
\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=isttext, prefix=isttext@}

\DeclareStringOption[english]{mainlanguage}
\newcommand*{\isttext@mainlanguage@english}{english}
\newcommand*{\isttext@mainlanguage@portuguese}{portuguese}

\DeclareBoolOption[false]{onehalfspacing}

\ProcessKeyvalOptions*

%-------------------------------------------------------------------------------
% Language
%-------------------------------------------------------------------------------
\ifxetexorluatex
    \RequirePackage{polyglossia}
    \ifx\isttext@mainlanguage\isttext@mainlanguage@english
        \setdefaultlanguage[variant=british]{english}
        \setotherlanguage[variant=portuguese]{portuguese}
    \fi
    \ifx\isttext@mainlanguage\isttext@mainlanguage@portuguese
        \setdefaultlanguage[variant=portuguese]{portuguese}
        \setotherlanguage[variant=british]{english}
    \fi
    \SetLanguageKeys{english}{indentfirst=true}
    \SetLanguageKeys{portuguese}{indentfirst=true}
\else
    \RequirePackage{babel}
    \RequirePackage{indentfirst}
\fi

%-------------------------------------------------------------------------------
% Unicode support
%-------------------------------------------------------------------------------
\ifxetexorluatex
\else
    \RequirePackage[utf8]{inputenc}
\fi

%-------------------------------------------------------------------------------
% Font
%-------------------------------------------------------------------------------
\ifxetexorluatex
    \RequirePackage{fontspec}
\else
    \RequirePackage{}
\fi

\RequirePackage[final]{microtype}

%-------------------------------------------------------------------------------
% Spacing
%-------------------------------------------------------------------------------
\ifisttext@onehalfspacing
    \RequirePackage{setspace}
    \onehalfspacing
\fi

%-------------------------------------------------------------------------------
% Penalties
%-------------------------------------------------------------------------------
% https://en.wikibooks.org/wiki/TeX/penalty
% https://tex.stackexchange.com/questions/4152/how-do-i-prevent-widow-orphan-lines
\binoppenalty=700        % 700
\brokenpenalty=100       % 100
\clubpenalty=10000       % 150
\displaywidowpenalty=50  % 50
\exhyphenpenalty=50      % 50
\floatingpenalty=20000   % 20000
\hyphenpenalty=50        % 50
\interlinepenalty=0      % 0
\linepenalty=10          % 10
\postdisplaypenalty=0    % 0
\predisplaypenalty=10000 % 10000
\relpenalty=500          % 500
\widowpenalty=10000      % 150
