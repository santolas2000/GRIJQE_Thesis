\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ist-ref}[2024/09/08 v0.1 References]

%-------------------------------------------------------------------------------
% Hyperref
%-------------------------------------------------------------------------------
\RequirePackage[
    pdfencoding=auto, psdextra,
    linktoc=all,
    hidelinks,
    breaklinks=true,
    pdfcreator={}, pdfproducer={}
]{hyperref}

%-------------------------------------------------------------------------------
% References
%-------------------------------------------------------------------------------
\RequirePackage[all]{hypcap}

\RequirePackage[english,capitalise,noabbrev]{cleveref}

