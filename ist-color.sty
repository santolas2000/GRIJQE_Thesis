\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ist-color}[2024/06/01 v0.1 Setup colours]

%-------------------------------------------------------------------------------
% Class options
%-------------------------------------------------------------------------------
\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=istcolor, prefix=istcolor@}

\DeclareBoolOption[false]{pm}

\ProcessKeyvalOptions*

%-------------------------------------------------------------------------------
% Packages
%-------------------------------------------------------------------------------
\RequirePackage{xcolor}

\RequirePackage{iftex}
\ifLuaTeX
  \RequirePackage{luacolor}
\fi

% ----- Custom Colours -----
\colorlet{darkgreen}{green!50!black}

% ----- Institutional Colours -----
% Instituto Superior Técnico
% https://tecnico.ulisboa.pt/pt/sobre-o-tecnico/institucional/logo-e-manual-de-identidade/
\definecolor{istblue}{RGB}{0,157,224}
\definecolor{istgrey}{RGB}{70,85,95}

% Faculdade de Medicina da Universidade de Lisboa
% https://www.medicina.ulisboa.pt/en/node/66
\definecolor{fmlyellow}{RGB}{234,184,24}

