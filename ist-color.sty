  \newlength{\ist@cpmheight@a}
  \settoheight{\ist@cpmheight@a}{$\displaystyle+$}
  \setlength{\ist@cpmheight@a}{.54\ist@cpmheight@a}
  \newlength{\ist@cpmheight@b}
  \settoheight{\ist@cpmheight@b}{$\textstyle+$}
  \setlength{\ist@cpmheight@b}{.54\ist@cpmheight@b}
  \newlength{\ist@cpmheight@c}
  \settoheight{\ist@cpmheight@c}{$\scriptstyle+$}
  \setlength{\ist@cpmheight@c}{.54\ist@cpmheight@c}
  \newlength{\ist@cpmheight@d}
  \settoheight{\ist@cpmheight@d}{$\scriptscriptstyle+$}
  \setlength{\ist@cpmheight@d}{.54\ist@cpmheight@d}

  \NewDocumentCommand{\ist@cpm}{mmmmm}{
    \mathbin{%
      \ooalign{%
        \raisebox{#2}{\color{#4}$#1+$}\cr
        \smash{\raisebox{#3}{\color{#5}$#1-$}}\cr%
      }%
    }%
  }

  \NewDocumentCommand{\cpm}{mm}{%
    \mathchoice%
    {\ist@cpm{\displaystyle}{0pt}{-\ist@cpmheight@a}{#1}{#2}}% displaystyle
    {\ist@cpm{\textstyle}{0pt}{-\ist@cpmheight@b}{#1}{#2}}% textstyle
    {\ist@cpm{\scriptstyle}{0pt}{-\ist@cpmheight@c}{#1}{#2}}% scriptstyle
    {\ist@cpm{\scriptscriptstyle}{0pt}{-\ist@cpmheight@d}{#1}{#2}}% scriptscriptstyle
  }

  \NewDocumentCommand{\cmp}{mm}{%
    \mathchoice%
    {\ist@cpm{\displaystyle}{0pt}{\ist@cpmheight@a}{#1}{#2}}% displaystyle
    {\ist@cpm{\textstyle}{0pt}{\ist@cpmheight@b}{#1}{#2}}% textstyle
    {\ist@cpm{\scriptstyle}{0pt}{\ist@cpmheight@c}{#1}{#2}}% scriptstyle
    {\ist@cpm{\scriptscriptstyle}{0pt}{\ist@cpmheight@d}{#1}{#2}}% scriptscriptstyle
  }
\fi
